rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function ownsDoc() {
      return signedIn() && resource.data.userId == currentUid();
    }

    // A deleted document has no owner to check. Letting a signed-in client read the absence lets it show
    // "not found" instead of a permission error it would retry forever.
    function ownsOrMissing() {
      return signedIn() && (resource == null || resource.data.userId == currentUid());
    }

    function ownsNewDoc() {
      return signedIn() && request.resource.data.userId == currentUid();
    }

    function keepsOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    function isMillis(value) {
      return value is int
             && value >= 0
             && value <= 4102444800000;
    }

    function isNonEmptyString(value, maxLength) {
      return value is string
             && value.size() > 0
             && value.size() <= maxLength;
    }

    function isNullableString(value, maxLength) {
      return value == null
             || (value is string && value.size() <= maxLength);
    }

    function isDocumentId(value) {
      return value is string
             && value.size() > 0
             && value.size() <= 160
             && value.matches('^[A-Za-z0-9][A-Za-z0-9._:-]*$');
    }

    function isCategory(value) {
      return value in ['chest', 'back', 'legs', 'shoulders', 'arms', 'core', 'cardio'];
    }

    function isEquipment(value) {
      return value in ['barbell', 'dumbbell', 'cable', 'machine', 'bodyweight', 'kettlebell'];
    }

    function isMuscleList(value) {
      return value is list
             && value.size() <= 12
             && value.hasOnly([
               'chest', 'back', 'quads', 'hamstrings', 'glutes',
               'shoulders', 'triceps', 'biceps', 'forearms', 'core', 'calves',
             ]);
    }

    function isActiveExercises(value) {
      // Active sessions are owner-only drafts. Their finalized payload is
      // validated by the server before it becomes workout history.
      return value is list
             && value.size() <= 20;
    }

    function hasNameClaim(data) {
      return data.keys().hasAll(['nameClaimId'])
             && isNonEmptyString(data.nameClaimId, 200);
    }

    function hasMatchingNameClaim(exerciseId, data) {
      return hasNameClaim(data)
             && existsAfter(/databases/$(database)/documents/userExerciseNames/$(data.nameClaimId))
             && getAfter(/databases/$(database)/documents/userExerciseNames/$(data.nameClaimId)).data.userId == currentUid()
             && getAfter(/databases/$(database)/documents/userExerciseNames/$(data.nameClaimId)).data.exerciseId == exerciseId
             && getAfter(/databases/$(database)/documents/userExerciseNames/$(data.nameClaimId)).data.name == data.name;
    }

    function isUserExerciseNameClaim(claimId, data) {
      return data.keys().hasOnly(['userId', 'exerciseId', 'name'])
             && data.keys().hasAll(['userId', 'exerciseId', 'name'])
             && data.userId == currentUid()
             && claimId.matches('^' + currentUid() + '_[0-9a-f]{64}$')
             && isNonEmptyString(data.exerciseId, 160)
             && isNonEmptyString(data.name, 120);
    }

    function isUserExercise(data) {
      return data.keys().hasOnly(['userId', 'name', 'category', 'equipment', 'muscles', 'nameClaimId'])
             && data.keys().hasAll(['userId', 'name', 'category', 'equipment', 'muscles'])
             && data.userId == currentUid()
             && isNonEmptyString(data.name, 120)
             && isCategory(data.category)
             && isEquipment(data.equipment)
             && isMuscleList(data.muscles);
    }

    function isReadiness(id, data) {
      return data.keys().hasOnly(['userId', 'date', 'sleep', 'mood', 'soreness', 'createdAt'])
             && data.keys().hasAll(['userId', 'date', 'sleep', 'mood', 'soreness', 'createdAt'])
             && data.userId == currentUid()
             && data.date is string
             && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
             && id == currentUid() + '_' + data.date
             && data.sleep is int
             && data.sleep >= 1
             && data.sleep <= 5
             && data.mood is int
             && data.mood >= 1
             && data.mood <= 5
             && data.soreness is int
             && data.soreness >= 1
             && data.soreness <= 5
             && isMillis(data.createdAt);
    }

    function isActiveSession(uid, data) {
      return data.keys().hasAll(['userId', 'sessionId', 'sessionRevision', 'startedAt', 'templateId', 'label', 'exercises', 'updatedAt'])
             && data.keys().hasOnly(['userId', 'sessionId', 'sessionRevision', 'startedAt', 'templateId', 'label', 'exercises', 'updatedAt'])
             && currentUid() == uid
             && data.userId == currentUid()
             && isDocumentId(data.sessionId)
             && isDocumentId(data.sessionRevision)
             && !exists(/databases/$(database)/documents/closedSessions/$(data.sessionId))
             && isMillis(data.startedAt)
             && isMillis(data.updatedAt)
             && data.updatedAt >= data.startedAt
             && isNullableString(data.templateId, 160)
             && isNullableString(data.label, 120)
             && isActiveExercises(data.exercises);
    }

    function isUserProfile(data) {
      return data.keys().hasOnly(['displayName', 'weeklyGoal', 'primaryGoal', 'units', 'createdAt'])
             && data.keys().hasAll(['displayName', 'weeklyGoal', 'primaryGoal', 'units', 'createdAt'])
             && isNonEmptyString(data.displayName, 80)
             && data.weeklyGoal is int
             && data.weeklyGoal >= 1
             && data.weeklyGoal <= 14
             && data.primaryGoal in ['strength', 'hypertrophy', 'endurance', 'weight_loss']
             && data.units in ['kg', 'lbs']
             && isMillis(data.createdAt);
    }

    match /workouts/{id} {
      allow get: if ownsOrMissing();
      allow list: if ownsDoc();
      allow create, update, delete: if false;
    }

    match /exerciseSessions/{id} {
      allow read: if ownsDoc();
      allow create, update, delete: if false;
    }

    match /records/{id} {
      allow read: if ownsDoc();
      allow create, update, delete: if false;
    }

    match /chatMessages/{id} {
      allow read: if ownsDoc();
      allow create, update, delete: if false;
    }

    match /dailyAiUsage/{id} {
      allow read, write: if false;
    }

    match /closedSessions/{id} {
      allow read, write: if false;
    }

    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /exerciseCreateOperations/{id} {
      allow read, write: if false;
    }

    match /userExercises/{id} {
      allow create: if ownsNewDoc()
                    && isUserExercise(request.resource.data)
                    && hasMatchingNameClaim(id, request.resource.data);
      allow get: if ownsOrMissing();
      allow list: if ownsDoc();
      allow update: if ownsDoc()
                    && keepsOwner()
                    && isUserExercise(request.resource.data)
                    && (
                      hasMatchingNameClaim(id, request.resource.data)
                      || (
                        !hasNameClaim(resource.data)
                        && !hasNameClaim(request.resource.data)
                        && request.resource.data.name == resource.data.name
                      )
                    );
      allow delete: if ownsDoc()
                    && (
                      !hasNameClaim(resource.data)
                      || !existsAfter(/databases/$(database)/documents/userExerciseNames/$(resource.data.nameClaimId))
                    );
    }

    match /userExerciseNames/{claimId} {
      allow read: if signedIn()
                  && claimId.matches('^' + currentUid() + '_[0-9a-f]{64}$');
      allow create: if ownsNewDoc()
                    && isUserExerciseNameClaim(claimId, request.resource.data)
                    && existsAfter(/databases/$(database)/documents/userExercises/$(request.resource.data.exerciseId))
                    && getAfter(/databases/$(database)/documents/userExercises/$(request.resource.data.exerciseId)).data.userId == currentUid()
                    && getAfter(/databases/$(database)/documents/userExercises/$(request.resource.data.exerciseId)).data.nameClaimId == claimId
                    && getAfter(/databases/$(database)/documents/userExercises/$(request.resource.data.exerciseId)).data.name == request.resource.data.name;
      allow update: if false;
      allow delete: if ownsDoc()
                    && (
                      !existsAfter(/databases/$(database)/documents/userExercises/$(resource.data.exerciseId))
                      || getAfter(/databases/$(database)/documents/userExercises/$(resource.data.exerciseId)).data.nameClaimId != claimId
                    );
    }

    match /templates/{id} {
      allow create, update: if false;
      allow get: if ownsOrMissing();
      allow list: if ownsDoc();
      allow delete: if ownsDoc();
    }

    match /templateSaveOperations/{id} {
      allow read, write: if false;
    }

    match /readiness/{id} {
      allow create: if ownsNewDoc()
                    && isReadiness(id, request.resource.data);
      allow read: if signedIn() && id.matches('^' + currentUid() + '_.+$');
      allow update: if ownsDoc()
                    && keepsOwner()
                    && isReadiness(id, request.resource.data);
      allow delete: if ownsDoc();
    }

    match /activeSessions/{uid} {
      allow create: if signedIn()
                    && currentUid() == uid
                    && request.resource.data.userId == currentUid()
                    && isActiveSession(uid, request.resource.data);
      allow read: if signedIn() && currentUid() == uid;
      allow update: if signedIn()
                    && currentUid() == uid
                    && request.resource.data.userId == resource.data.userId
                    && isActiveSession(uid, request.resource.data);
      allow delete: if signedIn() && currentUid() == uid;
    }

    match /users/{id} {
      allow read: if signedIn() && currentUid() == id;
      allow create, update: if signedIn()
                            && currentUid() == id
                            && isUserProfile(request.resource.data);
      allow delete: if signedIn() && currentUid() == id;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
