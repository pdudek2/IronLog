rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function ownsDoc() {
      return signedIn() && resource.data.userId == currentUid();
    }

    function ownsNewDoc() {
      return signedIn() && request.resource.data.userId == currentUid();
    }

    function keepsOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    match /workouts/{id} {
      allow create: if ownsNewDoc()
                    && request.resource.data.materialized == false;
      allow read: if ownsDoc();
      allow update, delete: if false;
    }

    match /exerciseSessions/{id} {
      allow read: if ownsDoc();
      allow create, update, delete: if false;
    }

    match /records/{id} {
      allow read: if ownsDoc();
      allow create, update, delete: if false;
    }

    match /chatMessages/{id} {
      allow read: if ownsDoc();
      allow create, update, delete: if false;
    }

    match /dailyAiUsage/{id} {
      allow read, write: if false;
    }

    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /userExercises/{id} {
      allow create: if ownsNewDoc();
      allow read: if ownsDoc();
      allow update, delete: if ownsDoc() && keepsOwner();
    }

    match /templates/{id} {
      allow create: if ownsNewDoc();
      allow read: if ownsDoc();
      allow update, delete: if ownsDoc() && keepsOwner();
    }

    match /readiness/{id} {
      allow create: if ownsNewDoc();
      allow read: if ownsDoc();
      allow update, delete: if ownsDoc() && keepsOwner();
    }

    match /activeSessions/{uid} {
      allow create: if signedIn()
                    && currentUid() == uid
                    && request.resource.data.userId == currentUid();
      allow read: if signedIn() && currentUid() == uid;
      allow update: if signedIn()
                    && currentUid() == uid
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && currentUid() == uid;
    }

    match /users/{id} {
      allow read, write: if signedIn() && currentUid() == id;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
