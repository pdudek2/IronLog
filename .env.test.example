# Playwright test credentials — copy to .env.test and fill in real values
# .env.test is gitignored; this file is committed as a template

TEST_EMAIL=your-test-account@example.com
TEST_PASSWORD=your-test-password

# Used only by npm run test:e2e / test:e2e:live (live backend).
# npm run test:e2e:isolated supplies deterministic emulator credentials itself.
