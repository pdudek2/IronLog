# Copy the Firebase Android client file to config/google-services.json (ignored).
IRONLOG_GOOGLE_SERVICES_FILE=./config/google-services.json

# Emulator builds require both values. With an authorized USB device, use
# adb reverse tcp:9099 tcp:9099 and adb reverse tcp:8080 tcp:8080.
IRONLOG_MOBILE_BACKEND=emulator
IRONLOG_MOBILE_FIREBASE_HOST=127.0.0.1
