{
  "name": "ironlog-mobile",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13 <25"
  },
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:emulator": "node --import tsx integration/firestoreAdapter.emulator.ts",
    "test:emulator:profile": "node --import ./integration/exercise-sdk-shims/register.mjs --import tsx integration/profile.emulator.ts",
    "test:emulator:readiness": "node --import ./integration/exercise-sdk-shims/register.mjs --import tsx integration/readiness.emulator.ts",
    "test:emulator:exercises": "node --import ./integration/exercise-sdk-shims/register.mjs --import tsx integration/exerciseCatalogue.emulator.ts"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/spline-sans-mono": "^0.4.2",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.0"
  }
}
