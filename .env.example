# Public browser configuration (VITE_* values are bundled into the client).
# These demo placeholders target local emulators. For a live project, use
# Firebase console -> Project settings -> Web app and disable emulators below.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ironlog.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ironlog
VITE_FIREBASE_STORAGE_BUCKET=demo-ironlog.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:demo
VITE_FIREBASE_USE_EMULATORS=true

# Server-only Firebase Admin configuration. Never prefix credentials with VITE_.
# Local API: Node.js; deployment: Vercel Node.js Functions, not Edge.
FIREBASE_PROJECT_ID=demo-ironlog
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Live certificate example (placeholder only; keep the value on one line):
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-placeholder@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_BODY\n-----END PRIVATE KEY-----\n"
# Literal \n is converted to a newline by api/_lib/firebaseAdmin.ts.
# Without all three certificate fields, live mode uses Application Default Credentials.

# Local emulator routing. Remove these three variables for live Firebase.
# Admin prefers GCLOUD_PROJECT over FIREBASE_PROJECT_ID when an emulator is set.
GCLOUD_PROJECT=demo-ironlog
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
